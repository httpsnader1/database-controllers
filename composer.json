{
    "name": "httpsnader1/database-controllers",
    "description": "Control your laravel database",
    "type": "library",
    "require": {
        "php": "^8.0",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Httpsnader1\\DatabaseControllers\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Httpsnader1\\DatabaseControllers\\DatabaseControllersServiceProvider"
            ]
        }
    }
}
